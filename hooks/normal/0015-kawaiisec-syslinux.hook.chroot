#!/bin/bash

# KawaiiSec OS Syslinux Bootloader Branding Hook  
# Ensures syslinux boot menu shows KawaiiSec branding

set -e

echo "🚀 Applying KawaiiSec OS syslinux branding..."

# Source directory inside chroot (populated via includes.chroot)
SYSLINUX_ASSETS="/usr/share/kawaiisec/bootloaders/syslinux"

if [ -d "$SYSLINUX_ASSETS" ]; then
    echo "📂 Found syslinux assets in $SYSLINUX_ASSETS"
    
    # Create standard syslinux directories
    mkdir -p /usr/share/syslinux
    mkdir -p /usr/lib/syslinux/modules/bios
    
    # Copy configuration
    if [ -f "$SYSLINUX_ASSETS/syslinux.cfg" ]; then
        cp "$SYSLINUX_ASSETS/syslinux.cfg" /usr/share/syslinux/isolinux.cfg || true
        cp "$SYSLINUX_ASSETS/syslinux.cfg" /usr/share/syslinux/syslinux.cfg || true
    fi
    
    # Copy splash image
    if [ -f "$SYSLINUX_ASSETS/splash.png" ]; then
        cp "$SYSLINUX_ASSETS/splash.png" /usr/share/syslinux/splash.png || true
        cp "$SYSLINUX_ASSETS/splash.png" /usr/lib/syslinux/splash.png || true
    fi
    
    echo "✅ Syslinux assets installed"
else
    echo "⚠️ Warning: Syslinux assets not found in $SYSLINUX_ASSETS"
fi

# Update existing configurations
for config_file in /usr/share/syslinux/isolinux.cfg /usr/share/syslinux/syslinux.cfg /usr/lib/syslinux/isolinux.cfg; do
    if [ -f "$config_file" ]; then
        echo "⚙️ Updating syslinux configuration: $config_file"
        
        # Ensure the menu title shows KawaiiSec OS
        sed -i 's/MENU TITLE .*/MENU TITLE KawaiiSec OS Live/' "$config_file" 2>/dev/null || true
        
        # Update kernel parameters to include KawaiiSec hostname and username
        sed -i 's/hostname=[^ ]*/hostname=kawaiisec/g' "$config_file" 2>/dev/null || true
        sed -i 's/username=[^ ]*/username=kawaiisec/g' "$config_file" 2>/dev/null || true
        
        echo "✅ Updated $config_file"
    fi
done

echo "✅ KawaiiSec OS syslinux branding applied!"