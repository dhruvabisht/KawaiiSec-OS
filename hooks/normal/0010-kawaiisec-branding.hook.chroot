#!/bin/bash

# KawaiiSec OS Branding Hook
# Applies custom branding and assets during ISO build

set -e

echo "🌸 Applying KawaiiSec OS branding..."

# Ensure target directories exist
echo "📁 Setting up branding directories..."
mkdir -p /usr/share/backgrounds/kawaiisec
mkdir -p /usr/share/icons/kawaiisec
mkdir -p /usr/share/pixmaps/kawaiisec
mkdir -p /usr/share/kawaiisec/res/Wallpapers
mkdir -p /usr/share/kawaiisec/assets/graphics
mkdir -p /usr/share/kawaiisec/assets/themes
mkdir -p /usr/share/kawaiisec/assets/audio

# Step 1: Deploy Wallpapers
echo "🎨 Deploying wallpapers..."
# Source is includes.chroot/usr/share/backgrounds/kawaiisec which is already in /usr/share/backgrounds/kawaiisec
if [ -d "/usr/share/backgrounds/kawaiisec" ]; then
    # Copy to internal asset directory for backup/reference
    cp -r /usr/share/backgrounds/kawaiisec/* /usr/share/kawaiisec/res/Wallpapers/ 2>/dev/null || true
    
    # Copy to standard background locations
    cp /usr/share/backgrounds/kawaiisec/*.png /usr/share/backgrounds/ 2>/dev/null || true
    cp /usr/share/backgrounds/kawaiisec/*.png /usr/share/pixmaps/ 2>/dev/null || true
    
    # Set default wallpaper link
    ln -sf /usr/share/backgrounds/kawaiisec/kawaii_cafe.png /usr/share/backgrounds/kawaiisec/default.png
    ln -sf /usr/share/backgrounds/kawaiisec/kawaii_cafe.png /usr/share/backgrounds/default.png
else
    echo "⚠️ Warning: Wallpaper source directory /usr/share/backgrounds/kawaiisec not found!"
fi

# Step 2: Deploy Icons and Logos
echo "🎨 Deploying icons and logos..."
# Icons should already be in /usr/share/icons/kawaiisec from includes.chroot
if [ -d "/usr/share/icons/kawaiisec" ]; then
    # Copy logo to pixmaps
    if [ -f "/usr/share/icons/kawaiisec/Kawaii.png" ]; then
        cp /usr/share/icons/kawaiisec/Kawaii.png /usr/share/pixmaps/kawaiisec-logo.png
        cp /usr/share/icons/kawaiisec/Kawaii.png /usr/share/pixmaps/kawaiisec.png
    fi
    
    # Update icon cache
    gtk-update-icon-cache /usr/share/icons/kawaiisec/ 2>/dev/null || true
else
    echo "⚠️ Warning: Icon source directory /usr/share/icons/kawaiisec not found!"
fi

# Step 3: Configure Desktop Environment (XFCE)
echo "🖥️ Configuring XFCE branding..."
mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml

# Set XFCE default wallpaper via system-wide config
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/kawaiisec/kawaii_cafe.png"/>
        </property>
      </property>
      <!-- Fallback for other monitor names -->
      <property name="monitorVirtual1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/kawaiisec/kawaii_cafe.png"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# Set XFCE icon theme
mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Adwaita-dark"/>
    <property name="IconThemeName" type="string" value="kawaiisec"/>
  </property>
</channel>
EOF

# Step 4: System Identification
echo "📝 Setting up system identification..."
VERSION="2026.05.12"
CODENAME="kawaii"

cat > /etc/os-release << EOF
NAME="KawaiiSec OS"
VERSION="$VERSION"
ID=kawaiisec
ID_LIKE=debian
PRETTY_NAME="KawaiiSec OS $VERSION ($CODENAME)"
VERSION_ID="$VERSION"
HOME_URL="https://kawaiisec.org"
SUPPORT_URL="https://github.com/dhruvabisht/KawaiiSec-OS"
BUG_REPORT_URL="https://github.com/dhruvabisht/KawaiiSec-OS/issues"
VERSION_CODENAME=$CODENAME
EOF

echo "KawaiiSec OS $VERSION ($CODENAME)" > /etc/kawaiisec-version
echo "kawaii/sid" > /etc/debian_version

# Update issue and motd
cat > /etc/issue << 'EOF'
🌸 KawaiiSec OS \r \l
Welcome to KawaiiSec OS - Kawaii Cybersecurity Distribution
EOF

cat > /etc/motd << 'EOF'
    ╭─────────────────────────────────────────╮
    │        🌸 Welcome to KawaiiSec OS 🌸    │
    │     Kawaii Cybersecurity Distribution   │
    ╰─────────────────────────────────────────╯
    📚 Documentation: https://kawaiisec.org/docs
    💖 Happy hacking with kawaii vibes! 💖
EOF

# Step 5: Enable Firstboot
echo "🚀 Enabling first boot setup service..."
if [ -f /lib/systemd/system/kawaiisec-firstboot.service ]; then
    systemctl enable kawaiisec-firstboot.service || true
fi

# Step 6: Fix Hostname
echo "kawaiisec" > /etc/hostname

echo "✅ KawaiiSec OS branding applied successfully!"
 